# Copy to .env (gitignored) and fill in. The agent reads these via the env.
# Official DeepSeek API (OpenAI-compatible endpoint).
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-REPLACE_ME
CYBERGYM_MODEL=deepseek-flash

